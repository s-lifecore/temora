# Temora — .env.local の見本。値は `npx convex dev` を初回に実行すると自動で書き込まれる

# Convex のデプロイ（例: dev:xxx-yyy-123）
CONVEX_DEPLOYMENT=
# Convex のクライアント接続先（例: https://xxx-yyy-123.convex.cloud）
NEXT_PUBLIC_CONVEX_URL=
# Convex の HTTP Actions 用 URL（例: https://xxx-yyy-123.convex.site）
NEXT_PUBLIC_CONVEX_SITE_URL=

# 以下は .env ではなく Convex の環境変数に設定する（サーバー側だけで使うため）
#   npx convex env set ANTHROPIC_API_KEY <Claude API のキー>
#   npx convex env set AI_MOCK 1        # 1 にすると AI を呼ばず見本の判定で動く
#   npx convex env set AI_MODEL claude-haiku-5-5   # 使うモデル（未設定なら claude-haiku-5-5）
